# ==============================================================
# Seed Platform CNRA v0 — Template des variables d'environnement
# ==============================================================
# USAGE : Copier ce fichier en .env et remplir les valeurs réelles.
#   cp .env.example .env
#
# IMPORTANT : .env est dans .gitignore — ne jamais le commiter.
# Ce fichier (.env.example) est versionné mais sans valeurs réelles.
# ==============================================================


# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=seed
POSTGRES_USER=seed
POSTGRES_PASSWORD=CHANGER_MOT_DE_PASSE_POSTGRES


# ── Keycloak ───────────────────────────────────────────────────
# Compte administrateur de la console Keycloak (:18080)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGER_MOT_DE_PASSE_KEYCLOAK

# Secret du client Keycloak utilisé par les microservices Spring Boot.
# Doit correspondre à la valeur dans realm-seed-v0.json > clients[clientId=seed-services] > secret.
# En production : générer avec `openssl rand -base64 32`
KEYCLOAK_CLIENT_SECRET=CHANGER_SECRET_CLIENT


# ── Grafana ────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGER_MOT_DE_PASSE_GRAFANA


# ── Frontend — URLs publiques (Vite dans Docker) ───────────────
VITE_API_BASE=http://localhost
VITE_KEYCLOAK_URL=http://localhost:18080
VITE_KEYCLOAK_REALM=seed-v0
VITE_KEYCLOAK_CLIENT_ID=seed-frontend


# ── Microservices Spring Boot ──────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/seed
SPRING_DATASOURCE_USERNAME=seed
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KC_JWK_SET_URI=http://keycloak:8080/realms/seed-v0/protocol/openid-connect/certs
KC_REALM=seed-v0
